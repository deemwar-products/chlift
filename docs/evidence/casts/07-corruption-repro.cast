[110.999669, "o", "\u001b[1;32m$\u001b[0m \u001b[1mchlift migrate plan --tables public.notes_demo --min-rows 1 --mirror chlift_safe --database chlift_safe --plan safe.yaml\u001b[0m\r\n"]
[112.051518, "o", "migrate public.notes_demo                 19000 rows  ORDER BY (id)  \r\n    note: updated or deleted rows: sorted by primary key so de-duplication stays correct; queries need FINAL\r\n    note: sort key and partitioning cannot change after the table is created (PeerDB #4604): review them now\r\n    note: needs REPLICA IDENTITY FULL: it is updated and has TOAST-able columns (else unchanged long values arrive empty)\r\npostgres: ALTER TABLE \"public\".\"notes_demo\" REPLICA IDENTITY FULL\r\npostgres: CREATE PUBLICATION chlift_safe_pub FOR TABLE \"public\".\"notes_demo\"\r\nwrote safe.yaml: review it, then run `chlift migrate start`\r\n"]
[112.054242, "o", "\u001b[1;32m$\u001b[0m \u001b[1mchlift migrate start --plan safe.yaml --apply-postgres\u001b[0m\r\n"]
