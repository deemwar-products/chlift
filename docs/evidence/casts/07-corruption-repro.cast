[0.018255, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.019822, "o", "\u001b[1;32m$\u001b[0m \u001b[1mpsql -q -c \"CREATE TABLE notes_demo (id bigserial PRIMARY KEY, created_at timestamptz NOT NULL, touched int NOT NULL DEFAULT 0, body text NOT NULL); INSERT INTO notes_demo(created_at, body) SELECT now() - interval '2 days' - g * interval '1 minute', CASE WHEN g % 10 = 0 THEN (SELECT string_agg(md5(random()::text), '') FROM generate_series(1,128)) ELSE 'short' END FROM generate_series(1,20000) g; ANALYZE notes_demo\"\u001b[0m\r\n"]
[1.739853, "o", "\u001b[1;32m$\u001b[0m \u001b[1mchlift migrate plan --tables public.notes_demo --min-rows 1 --mirror chlift_unsafe --database chlift_unsafe --plan unsafe.yaml\u001b[0m"]
[1.740339, "o", "\r\n"]
[2.909676, "o", "migrate public.notes_demo                 20000 rows  ORDER BY (created_at, id)  toYYYYMM(created_at)\r\n    note: sort key and partitioning cannot change after the table is created (PeerDB #4604): review them now\r\n    note: needs REPLICA IDENTITY FULL: its sort key starts with created_at, and a DELETE (retention cleanup included) would otherwise leave the row live in ClickHouse\r\npostgres: ALTER TABLE \"public\".\"notes_demo\" REPLICA IDENTITY FULL\r\npostgres: CREATE PUBLICATION chlift_unsafe_pub FOR TABLE \"public\".\"notes_demo\"\r\nwrote unsafe.yaml: review it, then run `chlift migrate start`\r\n"]
[2.913005, "o", "\u001b[1;32m$\u001b[0m \u001b[1msed -i \"/REPLICA IDENTITY FULL/d\" unsafe.yaml && grep -A3 postgres_fixes unsafe.yaml\u001b[0m\r\n"]
[3.928606, "o", "postgres_fixes:\r\n    - CREATE PUBLICATION chlift_unsafe_pub FOR TABLE \"public\".\"notes_demo\"\r\n"]
[3.929419, "o", "\u001b[1;32m$\u001b[0m \u001b[1mchlift migrate start --plan unsafe.yaml --apply-postgres\u001b[0m\r\n"]
[5.697691, "o", "postgres: CREATE PUBLICATION chlift_unsafe_pub FOR TABLE \"public\".\"notes_demo\"\r\n"]
[6.259211, "o", "clickhouse: database chlift_unsafe (Replicated) on 2 replica(s)\r\n"]
[7.91514, "o", "peerdb: mirror chlift_unsafe created ({\"workflowId\":\"chlift_unsafe-peerflow\"}); snapshot then CDC. Follow with `chlift migrate status`\r\n"]
[7.924783, "o", "\u001b[1;32m$\u001b[0m \u001b[1msleep 40\u001b[0m\r\n"]
[48.932867, "o", "\u001b[1;32m$\u001b[0m \u001b[1mpsql -c \"UPDATE notes_demo SET touched = touched + 1 WHERE id % 5 = 0\" -c \"DELETE FROM notes_demo WHERE id <= 1000\"\u001b[0m\r\n"]
