[1.891959, "o", "chlift: postgres needs these changes first (rerun with --apply-postgres, or run them yourself):\r\n  ALTER TABLE \"public\".\"user_events\" REPLICA IDENTITY FULL;\r\n  ALTER TABLE \"public\".\"request_logs\" REPLICA IDENTITY FULL;\r\n  ALTER TABLE \"public\".\"system_logs\" REPLICA IDENTITY FULL;\r\n  CREATE PUBLICATION chlift_demo_pub FOR TABLE \"public\".\"user_events\", \"public\".\"request_logs\", \"public\".\"system_logs\";\r\n"]
[1.89259, "o", "\u001b[1;32m$\u001b[0m \u001b[1mchlift migrate start --apply-postgres\u001b[0m\r\n"]
